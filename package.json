{
  "name": "cers",
  "version": "2.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000 --experimental-https",
    "build": "pnpm run build-storybook && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "prepare": "husky || true",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook --quiet",
    "build:app": "next build",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test --project=chromium",
    "screenshots": "playwright test --project=screenshots",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "antd": "^5.29.3",
    "axios": "1.21.0",
    "date-fns": "^4.4.0",
    "jotai": "^2.20.3",
    "js-cookie": "^3.0.8",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-datepicker": "^8.10.0",
    "react-daum-postcode": "^3.2.0",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^5.0.0",
    "react-webcam": "^7.2.0",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "vite": "^6.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.15.3+sha512.1f79bc245a66eb0b07c5d4d83131240774642caaa86ef7d0434ab47c0d16f66b04e21e0c086eb61e62c77efc4d7f7ec071afad3796af64892fae66509173893a",
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.18",
      "@babel/runtime": "^7.26.10",
      "@humanfs/node@0": "^0.16.8",
      "brace-expansion@1": "^1.1.21",
      "flatted@3": "^3.4.4",
      "glob@10": "^10.5.0",
      "minimatch@3": "^3.1.5",
      "minimatch@>=7 <11.0.1": "^11.0.1",
      "picomatch@2": "^2.3.2",
      "postcss-selector-parser@6": "^6.1.5",
      "source-map-js@1": "^1.2.2",
      "yaml@2": "^2.8.3"
    }
  }
}
